{
  "name": "aidd-ilm-harness",
  "version": "0.1.0",
  "description": "AIDD-ILM experimental harness (Stage 0 historical + Stage 1 runtime).",
  "private": true,
  "scripts": {
    "run": "ts-node run.ts",
    "verify": "ts-node verify-logs.ts",
    "typecheck": "tsc --noEmit",
    "verify:context-conditions": "ts-node verify-context-conditions.ts",
    "verify:observable-interaction": "ts-node verify-observable-interaction.ts",
    "verify:working-set": "ts-node verify-working-set-manager.ts",
    "verify:working-set-reread": "ts-node verify-working-set-reread.ts",
    "verify:exploration-budget": "ts-node verify-exploration-budget.ts",
    "verify:research-stateless-episode": "ts-node verify-research-stateless-episode.ts",
    "verify:repository-accessor": "ts-node verify-repository-accessor.ts",
    "verify:agent-retrieved-runtime": "ts-node verify-agent-retrieved-runtime.ts",
    "verify:privileged-retrieval": "ts-node verify-privileged-retrieval-controller.ts",
    "verify:pr-ar-runtime-parity": "ts-node verify-pr-ar-runtime-parity.ts",
    "verify:openai": "ts-node verify-openai-backend.ts",
    "verify:openai-batch": "ts-node verify-openai-batch.ts",
    "verify:openai-live": "ts-node verify-openai-live.ts",
    "verify:openai-batch-live": "ts-node verify-openai-batch-live.ts",
    "verify:p2-openai-live": "ts-node verify-p2-openai-live.ts",
    "verify:run-validity": "ts-node verify-run-validity.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "dotenv": "^17.4.2",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3"
  }
}
