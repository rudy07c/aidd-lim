{
  "name": "aidd-ilm-synthetic-world",
  "version": "0.3.0",
  "description": "Synthetic Software World for AIDD-ILM: ground truth G, model checker, and validators.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check-ground-truth": "ts-node model_checker.ts ground_truth.json",
    "validate-tasks": "ts-node validate_task_deltas.ts",
    "validate-sequence": "ts-node validate_sequence.ts",
    "locality": "ts-node semantic_locality.ts",
    "demo:interaction-bug": "ts-node demo_interaction_only_bug.ts",
    "demo:order-dependency": "ts-node demo_order_dependency.ts",
    "verify-all": "npm run typecheck && npm run test && npm run check-ground-truth && npm run validate-tasks && npm run validate-sequence"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3"
  }
}
